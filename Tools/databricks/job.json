{
  "name": "Doorway: rebuild the walk tables",
  "description": "Runs Tools/databricks/ingest.py from GitHub's main whenever new logs land in workspace.doorway.logs (sync.py and upload.py put them there). Created from Tools/databricks/job.json.",
  "git_source": {
    "git_url": "https://github.com/Ayan-Syed/doorway",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "ingest",
      "notebook_task": {
        "notebook_path": "Tools/databricks/ingest",
        "source": "GIT",
        "base_parameters": {
          "catalog": "workspace",
          "schema": "doorway",
          "volume": "logs"
        }
      },
      "timeout_seconds": 1800
    }
  ],
  "trigger": {
    "pause_status": "UNPAUSED",
    "file_arrival": {
      "url": "/Volumes/workspace/doorway/logs/",
      "min_time_between_triggers_seconds": 60,
      "wait_after_last_change_seconds": 60
    }
  },
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  }
}
